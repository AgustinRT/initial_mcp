# Configuración de Mensajería - Kafka
# KAFKA_BOOTSTRAP_SERVERS lo define el fixture de test (Testcontainers o KAFKA_TEST_BOOTSTRAP_SERVERS)

KAFKA_CLIENT_ID="mcps"
KAFKA_SCHEMA_REGISTRY_URL="http://localhost:8081"

# Consumer de actualizaciones
CONSUMER_TOPICS="update"
CONSUMER_GROUP_ID="mcps-test"
CONSUMER_AUTO_OFFSET_RESET="earliest"
CONSUMER_POLL_TIMEOUT=500
CONSUMER_RETRY_BACKOFF_SECONDS=0.5
CONSUMER_RETRY_BACKOFF_MAX_SECONDS=2

# Tópico por defecto o para la cola principal de mensajes
DEFAULT_TOPIC="delete,update,create"

DEFAULT_PRODUCER_TOPIC="report"
PRODUCER_TIMEOUT_SECONDS=5
PRODUCER_RETRY_COOLDOWN_SECONDS=1
