# Configuración de Mensajería - Kafka
# (cualquier clave puede sobreescribirse con una variable de entorno del mismo nombre)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_CLIENT_ID="mcps"
KAFKA_SCHEMA_REGISTRY_URL="http://localhost:8081"

# Consumer de actualizaciones (activado en el lifespan del servidor MCP)
CONSUMER_TOPICS="update"
CONSUMER_GROUP_ID="mcps"
CONSUMER_AUTO_OFFSET_RESET="earliest"
CONSUMER_POLL_TIMEOUT=5000
CONSUMER_RETRY_BACKOFF_SECONDS=2
CONSUMER_RETRY_BACKOFF_MAX_SECONDS=30

# Tópico por defecto o para la cola principal de mensajes
DEFAULT_TOPIC="delete,update,create"

# Producer de reportes (best-effort: si no hay broker el servidor sigue funcionando)
DEFAULT_PRODUCER_TOPIC="report"
PRODUCER_TIMEOUT_SECONDS=5
PRODUCER_RETRY_COOLDOWN_SECONDS=30
